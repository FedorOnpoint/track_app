APP_ENV=development
APP_ADDR=:8080
APP_DOMAIN=localhost
DATABASE_URL=postgres://tracker:change-me@postgres:5432/tracker?sslmode=disable
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
SESSION_TTL=168h
LOG_LEVEL=info

# Optional user-scoped agent API. Configure all three or leave all empty.
AGENT_API_TOKEN_SHA256=
AGENT_USER_ID=
AGENT_TOKEN_EXPIRES_AT=

# Vercel: set APP_ENV=production and APP_DOMAIN to the public hostname
# (e.g. tracker.vercel.app, without https://). Preview deployments need
# their own APP_DOMAIN and a separate database to avoid changing production data.
# Set DATABASE_URL to the Neon pooled PostgreSQL URL with TLS enabled.
# Vercel supplies PORT automatically; do not set APP_ADDR or PORT there.
# Run migrate/seed/bootstrap separately using the direct database URL.

# Used only by the one-shot bootstrap command. Remove after use.
BOOTSTRAP_LOGIN=
BOOTSTRAP_PASSWORD=

# Production images must use the same immutable commit SHA.
API_IMAGE=
WEB_IMAGE=
