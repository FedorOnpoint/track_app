{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "browser/**/*.ts",
    "e2e/**/*.ts",
    "playwright.e2e.config.ts"
  ]
}
